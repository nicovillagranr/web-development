# Dependencias — se reinstalan con npm install, no se suben al repo
node_modules/
**/node_modules/

# Archivos de compilación — se regeneran al hacer build, no necesitan versionarse
dist/
build/
dist-ssr/
**/dist/
**/build/

# Logs — archivos de registro generados por los package managers al fallar
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Archivos del sistema operativo — macOS genera .DS_Store, Windows genera Thumbs.db
.DS_Store
Thumbs.db

# Variables de entorno — contienen datos sensibles (API keys, contraseñas, etc.)
.env
.env.local
.env.development
.env.production
.env.test

# Configuración local del editor — versionamos solo lo compartible del workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/

# Librería de iconos local — se mantiene en disco como recurso, no se versiona (infla el repo)
03-css/00-assets/icons/

# Librería de fuentes local — mismo criterio que los iconos: recurso re-descargable, no se versiona (~464 MB)
03-css/00-assets/fonts/

# Assets pesados del curso 3D (Three.js Journey) — re-descargables, se quedan en disco pero no se versionan (inflaban el repo ~1 GB)
04-javascript/05-libraries/3D/**/*.hdr
04-javascript/05-libraries/3D/**/*.exr
04-javascript/05-libraries/3D/**/*.glb
04-javascript/05-libraries/3D/**/*.gltf
04-javascript/05-libraries/3D/**/*.ktx
04-javascript/05-libraries/3D/**/*.ktx2
04-javascript/05-libraries/3D/**/*.basis
04-javascript/05-libraries/3D/**/*.tga
04-javascript/05-libraries/3D/**/static/**/*.png
04-javascript/05-libraries/3D/**/static/**/*.jpg
04-javascript/05-libraries/3D/**/static/**/*.jpeg
04-javascript/05-libraries/3D/**/static/**/*.webp
04-javascript/05-libraries/3D/**/static/**/*.mp4
04-javascript/05-libraries/3D/**/static/**/*.mp3

# Archivos generados por asistentes de IA — no aportan al código del proyecto
**/.agent/
**/.agents/
**/.claude/
**/.windsurf/
**/skills-lock.json
