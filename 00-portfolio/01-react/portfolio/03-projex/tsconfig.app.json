{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Rigor. Mismo trio que en store-pulse, para no tener dos dialectos de TS
       en el mismo portfolio:
       - strict: el paquete habitual (null checks, this implicito, etc.).
       - noUncheckedIndexedAccess: leer array[i] devuelve T | undefined. Aqui
         muerde en MapModal, donde se indexa el NodeList de elementos focusables.
       - exactOptionalPropertyTypes: `campo?: string` no acepta `undefined`
         explicito. Distingue "no pase la prop" de "la pase vacia". */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
