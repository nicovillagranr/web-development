<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sport-mindset/

    # Si la petición es un archivo o carpeta real, sírvelo tal cual
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra cosa → index.html (lo resuelve React Router)
    RewriteRule ^ index.html [L]
</IfModule>