# EmailJS Configuration
# Get these values from emailjs.com
# 1. Sign up at https://emailjs.com
# 2. Create a service (Gmail, Outlook, SMTP, etc.)
# 3. Create an email template with variables: {{from_name}}, {{from_email}}, {{company}}, {{message}}
# 4. Copy the Service ID, Template ID, and Public Key below

VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
