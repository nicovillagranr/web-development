{
  "compilerOptions": {
    "paths": {
      "@shell/*":    ["./src/hardware/*"],
      "@features/*": ["./src/features/*"],
      "@screen1/*":  ["./src/screens/screen-1/*"],
      "@screen2/*":  ["./src/screens/screen-2/*"],
      "@hooks/*":    ["./src/hooks/*"],
      "@ui/*":       ["./src/ui/*"],
      "@assets/*":   ["./src/assets/*"]
    }
  },
  "include": ["src"]
}
