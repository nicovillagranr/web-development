# Custom 404 page
ErrorDocument 404 /404.html

# HTML files — never cache (updated on every deploy)
<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# Assets with content hash in filename — cache forever (immutable)
<FilesMatch "\.(js|css|woff2?|ttf|webp|png|svg)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
