# Forzar UTF-8 y evitar dramas de codificación
* text=auto eol=lf

# Marcar archivos específicos como binarios (evita diffs raros)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Asegurar estilos coherentes en markdown
*.md text eol=lf
