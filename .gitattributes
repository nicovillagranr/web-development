# Enforce text normalization and LF by default
* text=auto eol=lf

# Common binary assets (avoid broken diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Keep markdown as text with LF
*.md text eol=lf

